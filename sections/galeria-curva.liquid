<div
  class="section section--{{ section.settings.section_width }} spacing-style curved-gallery"
  style="background: {{ section.settings.bg_color }}; position: relative; overflow: hidden; {% render 'spacing-style', settings: section.settings %}"
>
  <canvas class="curved-gallery__starfield" aria-hidden="true"></canvas>

  {%- if section.settings.heading != blank -%}
    <div class="curved-gallery__heading">{{ section.settings.heading }}</div>
  {%- endif -%}

  <div class="curved-gallery__stage" tabindex="0" role="region" aria-roledescription="carousel" aria-label="{{ section.settings.heading | default: 'Galería de imágenes' }}">
    <button type="button" class="curved-gallery__arrow curved-gallery__arrow--prev" aria-label="Imagen anterior">&#8592;</button>

    <div class="curved-gallery__track">
      {%- for i in (1..8) -%}
        {%- liquid
          case i
            when 1
              assign img = section.settings.image_1
            when 2
              assign img = section.settings.image_2
            when 3
              assign img = section.settings.image_3
            when 4
              assign img = section.settings.image_4
            when 5
              assign img = section.settings.image_5
            when 6
              assign img = section.settings.image_6
            when 7
              assign img = section.settings.image_7
            when 8
              assign img = section.settings.image_8
          endcase
        -%}
        <button
          type="button"
          class="curved-gallery__slide"
          data-index="{{ forloop.index0 }}"
          aria-label="Ver imagen {{ forloop.index }} de {{ forloop.length }}"
        >
          {%- if img != blank -%}
            {{
              img
              | image_url: width: 800
              | image_tag:
                class: 'curved-gallery__img',
                loading: 'lazy',
                widths: '300, 450, 600, 800',
                sizes: '260px'
            }}
          {%- else -%}
            <div class="curved-gallery__placeholder"></div>
          {%- endif -%}
        </button>
      {%- endfor -%}
    </div>

    <button type="button" class="curved-gallery__arrow curved-gallery__arrow--next" aria-label="Siguiente imagen">&#8594;</button>
  </div>

  <div class="curved-gallery__dots">
    {%- for i in (1..8) -%}
      <span class="curved-gallery__dot" data-index="{{ forloop.index0 }}" aria-hidden="true"></span>
    {%- endfor -%}
  </div>

  <div class="curved-gallery__button-wrap">
    <a
      href="{{ section.settings.button_link | default: '#' }}"
      class="curved-gallery__button"
    >
      {{ section.settings.button_text }}
    </a>
  </div>
</div>

<style>
  .curved-gallery__starfield {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
    pointer-events: none;
    display: block;
  }

  .curved-gallery__heading {
    position: relative;
    z-index: 1;
    text-align: center;
    font-size: clamp(1.3rem, 3vw, 2rem);
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0 0 36px;
  }

  .curved-gallery__stage {
    position: relative;
    z-index: 1;
    height: 380px;
    perspective: 1400px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: grab;
    outline: none;
    touch-action: pan-y;
    user-select: none;
  }

  .curved-gallery__stage--dragging {
    cursor: grabbing;
  }

  .curved-gallery__track {
    position: relative;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
  }

  .curved-gallery__slide {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 260px;
    height: 340px;
    margin: 0;
    border: none;
    padding: 0;
    background: #111111;
    border-radius: 18px;
    overflow: hidden;
    cursor: pointer;
    transition: transform 0.5s cubic-bezier(0.22, 0.68, 0, 1.01), opacity 0.5s ease, box-shadow 0.5s ease;
    box-shadow: 0 20px 45px rgba(0, 0, 0, 0.55);
    transform-style: preserve-3d;
  }

  .curved-gallery__slide--active {
    box-shadow: 0 25px 60px rgba(0, 0, 0, 0.7), 0 0 0 2px rgba(255, 255, 255, 0.25);
  }

  .curved-gallery__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }

  .curved-gallery__placeholder {
    width: 100%;
    height: 100%;
    background: linear-gradient(135deg, #1c1c1e, #0a0a0a);
  }

  .curved-gallery__arrow {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.35);
    color: #ffffff;
    font-size: 1.3rem;
    line-height: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    z-index: 50;
    transition: background 0.2s;
  }

  .curved-gallery__arrow:hover {
    background: rgba(255, 255, 255, 0.25);
  }

  .curved-gallery__arrow--prev {
    left: 4px;
  }

  .curved-gallery__arrow--next {
    right: 4px;
  }

  .curved-gallery__dots {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    gap: 8px;
    margin-top: 24px;
  }

  .curved-gallery__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.3);
    cursor: pointer;
    transition: background 0.2s, transform 0.2s;
  }

  .curved-gallery__dot--active {
    background: #ffffff;
    transform: scale(1.3);
  }

  .curved-gallery__button-wrap {
    position: relative;
    z-index: 1;
    display: flex;
    justify-content: center;
    margin-top: 36px;
  }

  .curved-gallery__button {
    display: inline-block;
    padding: 14px 40px;
    background: #ffffff;
    color: #000000;
    font-weight: 700;
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    border-radius: 999px;
    text-decoration: none;
    transition: transform 0.2s, background 0.2s;
  }

  .curved-gallery__button:hover {
    background: #e5e5e5;
    transform: translateY(-2px);
  }

  @media screen and (max-width: 749px) {
    .curved-gallery__stage {
      height: 260px;
    }

    .curved-gallery__slide {
      width: 170px;
      height: 230px;
      border-radius: 14px;
    }

    .curved-gallery__arrow {
      width: 36px;
      height: 36px;
      font-size: 1rem;
    }
  }
</style>

<script>
(function () {
  function initStarfield(section) {
    var canvas = section.querySelector('.curved-gallery__starfield');
    if (!canvas) return;
    var ctx = canvas.getContext('2d');
    var stars = [];
    var raf;

    function buildStars() {
      canvas.width = section.offsetWidth || 1200;
      canvas.height = section.offsetHeight || 600;
      stars = [];
      for (var i = 0; i < 140; i++) {
        stars.push({
          x: Math.random() * canvas.width,
          y: Math.random() * canvas.height,
          r: Math.random() * 1.4 + 0.3,
          phase: Math.random() * Math.PI * 2,
          speed: Math.random() * 0.012 + 0.004
        });
      }
    }

    function draw(t) {
      ctx.clearRect(0, 0, canvas.width, canvas.height);
      var time = t * 0.001;
      for (var i = 0; i < stars.length; i++) {
        var s = stars[i];
        var opacity = 0.15 + 0.75 * (0.5 + 0.5 * Math.sin(time * s.speed * 60 + s.phase));
        ctx.beginPath();
        ctx.arc(s.x, s.y, s.r, 0, 6.2832);
        ctx.fillStyle = 'rgba(255,255,255,' + opacity.toFixed(3) + ')';
        ctx.fill();
      }
      raf = requestAnimationFrame(draw);
    }

    buildStars();
    raf = requestAnimationFrame(draw);

    var resizeTimer;
    window.addEventListener('resize', function () {
      clearTimeout(resizeTimer);
      resizeTimer = setTimeout(function () {
        cancelAnimationFrame(raf);
        buildStars();
        raf = requestAnimationFrame(draw);
      }, 150);
    });
  }

  function initCurvedGallery(section) {
    var stage = section.querySelector('.curved-gallery__stage');
    if (!stage) return;
    var slides = Array.prototype.slice.call(section.querySelectorAll('.curved-gallery__slide'));
    var dots = Array.prototype.slice.call(section.querySelectorAll('.curved-gallery__dot'));
    var prevBtn = section.querySelector('.curved-gallery__arrow--prev');
    var nextBtn = section.querySelector('.curved-gallery__arrow--next');
    if (!slides.length) return;

    var total = slides.length;
    var current = 0;
    var autoTimer = null;

    function cfg() {
      return window.innerWidth < 750
        ? { x: 120, rot: 30, z: 90 }
        : { x: 220, rot: 34, z: 160 };
    }

    function render() {
      var c = cfg();
      slides.forEach(function (slide, index) {
        var diff = index - current;
        if (diff > total / 2) diff -= total;
        if (diff < -total / 2) diff += total;
        var abs = Math.abs(diff);
        var visible = abs <= 3;

        slide.style.zIndex = 100 - abs;
        slide.style.opacity = visible ? Math.max(1 - abs * 0.28, 0) : 0;
        slide.style.pointerEvents = visible ? 'auto' : 'none';
        slide.style.transform =
          'translate(-50%, -50%) translateX(' + diff * c.x + 'px) translateZ(' + -abs * c.z + 'px) rotateY(' + diff * -c.rot + 'deg) scale(' + Math.max(1 - abs * 0.14, 0.55) + ')';
        slide.classList.toggle('curved-gallery__slide--active', diff === 0);
        slide.setAttribute('aria-current', diff === 0 ? 'true' : 'false');
      });

      dots.forEach(function (dot, i) {
        dot.classList.toggle('curved-gallery__dot--active', i === current);
      });
    }

    function goTo(index) {
      current = ((index % total) + total) % total;
      render();
    }

    function next() { goTo(current + 1); }
    function prev() { goTo(current - 1); }

    function startAuto() {
      stopAuto();
      autoTimer = setInterval(next, 3800);
    }
    function stopAuto() {
      clearInterval(autoTimer);
      autoTimer = null;
    }

    prevBtn && prevBtn.addEventListener('click', function () { stopAuto(); prev(); });
    nextBtn && nextBtn.addEventListener('click', function () { stopAuto(); next(); });

    slides.forEach(function (slide, index) {
      slide.addEventListener('click', function () {
        if (index !== current) {
          stopAuto();
          goTo(index);
        }
      });
    });

    dots.forEach(function (dot, index) {
      dot.addEventListener('click', function () {
        stopAuto();
        goTo(index);
      });
    });

    var startX = 0;
    var deltaX = 0;
    var dragging = false;

    function pointerX(e) {
      return e.touches ? e.touches[0].clientX : e.clientX;
    }

    function onDown(e) {
      dragging = true;
      startX = pointerX(e);
      deltaX = 0;
      stopAuto();
      stage.classList.add('curved-gallery__stage--dragging');
    }

    function onMove(e) {
      if (!dragging) return;
      deltaX = pointerX(e) - startX;
    }

    function onUp() {
      if (!dragging) return;
      dragging = false;
      stage.classList.remove('curved-gallery__stage--dragging');
      if (Math.abs(deltaX) > 40) {
        deltaX < 0 ? next() : prev();
      }
      deltaX = 0;
      startAuto();
    }

    stage.addEventListener('mousedown', onDown);
    window.addEventListener('mousemove', onMove);
    window.addEventListener('mouseup', onUp);
    stage.addEventListener('touchstart', onDown, { passive: true });
    stage.addEventListener('touchmove', onMove, { passive: true });
    stage.addEventListener('touchend', onUp);

    stage.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowLeft') { stopAuto(); prev(); startAuto(); }
      if (e.key === 'ArrowRight') { stopAuto(); next(); startAuto(); }
    });

    stage.addEventListener('mouseenter', stopAuto);
    stage.addEventListener('mouseleave', startAuto);

    window.addEventListener('resize', render);

    render();
    startAuto();
  }

  document.querySelectorAll('.curved-gallery').forEach(function (section) {
    initStarfield(section);
    initCurvedGallery(section);
  });

  document.addEventListener('shopify:section:load', function (e) {
    var section = e.target.querySelector('.curved-gallery');
    if (section) {
      initStarfield(section);
      initCurvedGallery(section);
    }
  });
})();
</script>

{% schema %}
{
  "name": "Galería curva",
  "tag": "section",
  "class": "curved-gallery-section",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Título",
      "default": "Nuestra colección"
    },
    {
      "type": "header",
      "content": "Imágenes"
    },
    {
      "type": "image_picker",
      "id": "image_1",
      "label": "Imagen 1"
    },
    {
      "type": "image_picker",
      "id": "image_2",
      "label": "Imagen 2"
    },
    {
      "type": "image_picker",
      "id": "image_3",
      "label": "Imagen 3"
    },
    {
      "type": "image_picker",
      "id": "image_4",
      "label": "Imagen 4"
    },
    {
      "type": "image_picker",
      "id": "image_5",
      "label": "Imagen 5"
    },
    {
      "type": "image_picker",
      "id": "image_6",
      "label": "Imagen 6"
    },
    {
      "type": "image_picker",
      "id": "image_7",
      "label": "Imagen 7"
    },
    {
      "type": "image_picker",
      "id": "image_8",
      "label": "Imagen 8"
    },
    {
      "type": "header",
      "content": "Botón"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Texto del botón",
      "default": "Diligencia tu pedido"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Enlace del botón"
    },
    {
      "type": "header",
      "content": "Diseño de sección"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "Ancho de la sección",
      "options": [
        { "value": "full-width", "label": "Completo" },
        { "value": "page-width", "label": "Página" }
      ],
      "default": "full-width"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Color de fondo",
      "default": "#000000"
    },
    {
      "type": "header",
      "content": "Espaciado"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espacio superior",
      "default": 60
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Espacio inferior",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "Galería curva"
    }
  ]
}
{% endschema %}
